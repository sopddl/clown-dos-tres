---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

// Pour ajouter une photo : déposez le fichier dans src/assets/photos/, il apparaît ici automatiquement.
const photosModules = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', {
	eager: true,
});
const photos = Object.values(photosModules).map((mod) => mod.default);
---

<Layout title="Galerie" description="Photos des spectacles et scènes ouvertes du collectif Clown, dos, très.">
	<section class="section">
		<div class="wrap">
			<p class="eyebrow">En scène</p>
			<h1>Galerie</h1>
			<p>Quelques instants des Mercredis du Clown, capturés sur la péniche.</p>
			<div class="grid">
				{
					photos.map((photo) => (
						<div class="tile">
							<Image
								src={photo}
								alt="Photo d'un spectacle du collectif Clown, dos, très sur la Péniche Grande Fantaisie"
								widths={[320, 640]}
								sizes="(max-width: 700px) 45vw, 300px"
							/>
						</div>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	.grid {
		margin-top: 2rem;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1rem;
	}

	.tile {
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border-radius: 3px;
	}

	.tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
</style>
