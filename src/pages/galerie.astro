---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import OngletsGalerie from '../components/OngletsGalerie.astro';
import { photosGalerie, rubriques } from '../data/photos';

// Pour ajouter une photo : déposez le fichier dans src/assets/photos/ et ajoutez sa ligne dans src/data/photos.ts.
const photosModules = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', {
	eager: true,
});
const altParDefaut = "Photo d'un spectacle du collectif Clown, dos, tres sur la Péniche Grande Fantaisie";
const photos = Object.entries(photosModules).map(([chemin, mod]) => {
	const info = photosGalerie[chemin.split('/').pop()!];
	return { image: mod.default, alt: info?.alt ?? altParDefaut, rubrique: info?.rubrique ?? 'clownologie' };
});

// « En scène » puis « Ateliers », chaque rubrique avec ses photos (format d'origine, sans recadrage).
const parties = ['En scène', 'Ateliers'].map((partie) => ({
	partie,
	rubriques: rubriques
		.filter((r) => r.partie === partie)
		.map((r) => ({ ...r, photos: photos.filter((p) => p.rubrique === r.id) }))
		.filter((r) => r.photos.length > 0),
}));
---

<Layout
	title="Galerie"
	fullTitle="Photos des Mercredis du Clown · Clown, dos, tres"
	description="Photos du collectif Clown, dos, tres : Clownologie, cabarets Clown à l'usine, K barré, festival MigrActions, ateliers et scènes ouvertes clown à Paris."
>
	<section class="section">
		<div class="wrap">
			<h1>Galerie</h1>
			<OngletsGalerie actif="collectif" />
			{
				parties.map((p) => (
					<section class="partie">
						<h2>{p.partie}</h2>
						{p.rubriques.map((r) => (
							<div class="rubrique">
								<h3>{r.titre}</h3>
								<div class="photos">
									{r.photos.map((photo) => (
										<Image
											src={photo.image}
											alt={photo.alt}
											widths={[400, 800]}
											sizes="(max-width: 700px) 100vw, 360px"
										/>
									))}
								</div>
							</div>
						))}
					</section>
				))
			}
		</div>
	</section>
</Layout>

<style>
	.partie + .partie {
		margin-top: 3rem;
	}

	.rubrique {
		margin-top: 1.5rem;
	}

	h3 {
		font-size: 1.15rem;
		margin: 0 0 0.8rem;
	}

	/* Colonnes : chaque photo garde son format, paysage ou portrait. */
	.photos {
		columns: 3 260px;
		column-gap: 1rem;
	}

	.photos :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 1rem;
		break-inside: avoid;
		border-radius: 3px;
	}
</style>
