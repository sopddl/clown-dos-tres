---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

// Pour ajouter une photo : déposez le fichier dans src/assets/photos/, il apparaît ici automatiquement.
const photosModules = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', {
	eager: true,
});
const photos = Object.values(photosModules).map((mod) => mod.default);
// Deux blocs : les paysages puis les portraits, chacun dans des cases à son format (pas de recadrage).
const paysages = photos.filter((photo) => photo.width >= photo.height);
const portraits = photos.filter((photo) => photo.width < photo.height);
const alt = "Photo d'un spectacle du collectif Clown, dos, très sur la Péniche Grande Fantaisie";
---

<Layout
	title="Galerie"
	description="Photos des Mercredis du Clown : spectacles, cabarets et scènes ouvertes du collectif Clown, dos, très sur la Péniche Grande Fantaisie, Paris 19e."
>
	<section class="section">
		<div class="wrap">
			<p class="eyebrow">En scène</p>
			<h1>Galerie</h1>
			<p>Quelques instants des Mercredis du Clown, capturés sur la péniche.</p>
			<div class="grid grid-paysage">
				{
					paysages.map((photo) => (
						<div class="tile tile-paysage">
							<Image src={photo} alt={alt} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 380px" />
						</div>
					))
				}
			</div>
			<div class="grid grid-portrait">
				{
					portraits.map((photo) => (
						<div class="tile tile-portrait">
							<Image src={photo} alt={alt} widths={[320, 640]} sizes="(max-width: 700px) 45vw, 300px" />
						</div>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	.grid {
		margin-top: 2rem;
		display: grid;
		gap: 1rem;
	}

	.grid-paysage {
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
	}

	.grid-portrait {
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
	}

	.tile {
		overflow: hidden;
		border-radius: 3px;
	}

	.tile-paysage {
		aspect-ratio: 16 / 9;
	}

	.tile-portrait {
		aspect-ratio: 1654 / 2339;
	}

	.tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
</style>
