---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import portrait from '../assets/photos/9bfebea5-83a1-4723-8135-d1fccf9fdb10-1.jpg';
import clownologie from '../assets/posters/clownologie.jpg';
import cabaret from '../assets/posters/cabaret-clown-usine-1.jpg';
import salut from '../assets/photos/salut-troupe.jpg';
import duo from '../assets/photos/duo-paravent.jpg';
import trench from '../assets/photos/clown-trench.jpg';
import drape1 from '../assets/photos/clown-drape-1.jpg';
import drape2 from '../assets/photos/clown-drape-2.jpg';
import marie from '../assets/photos/marie-cafe-de-paris.jpg';

const enImages = [
	{ src: salut, alt: 'Salut final de la troupe de clowns sur la scène de la Péniche Grande Fantaisie' },
	{ src: duo, alt: 'Duo de clowns au nez rouge devant un paravent fleuri, sur la péniche' },
	{ src: trench, alt: 'Clown en trench-coat et chaussettes rayées, un carnet à la main' },
	{ src: drape1, alt: 'Clown drapé dans un tissu gris face au public, spectacle Clownologie' },
	{ src: drape2, alt: 'Clown drapé, la main sur le cœur, devant les enfants du public' },
	{ src: marie, alt: 'Marie en clown, veste rouge et nœud vert, sur la scène du Café de Paris' },
];
---

<Layout
	title="Le Collectif"
	description="Clown, dos, très : collectif d'artistes clowns qui anime les Mercredis du Clown sur la Péniche Grande Fantaisie, quai de l'Oise, Paris 19e. Photos et contact."
>
	<section class="section intro">
		<div class="wrap intro-grid">
			<div class="portrait">
				<Image src={portrait} alt="François Durègne en clown, sur scène" />
			</div>
			<div>
				<p class="eyebrow">Le Collectif</p>
				<h1>Clown, dos, très</h1>
				<p>
					<strong>Clown, dos, très</strong> réunit des artistes clowns qui animent Les Mercredis
					du Clown sur la Péniche Grande Fantaisie, à Paris. Parmi eux, <strong>François
					Durègne</strong>, clown et metteur en scène.
				</p>
				<p>
					Le collectif ouvre régulièrement le plateau à d'autres artistes lors de ses scènes
					ouvertes, dans un esprit de rencontre et de bienveillance — grands clowns à la
					renommée internationale ou tout juste fraîchement internationalement reconnus.
				</p>
			</div>
		</div>
	</section>

	<section class="section section-alt">
		<div class="wrap">
			<p class="eyebrow">Sur la même péniche</p>
			<h2>Cabaret Clown &amp; Clownologie</h2>
			<p>
				D'autres rendez-vous clown ponctuent également la programmation de la péniche, portés
				par l'atelier hebdomadaire Clown à l'Usine (Chapal, Montreuil) — dont François Durègne
				fait aussi partie.
			</p>
			<div class="affiches">
				<div class="affiche-tile">
					<Image src={cabaret} alt="Affiche Cabaret Clown à l'Usine" />
				</div>
				<div class="affiche-tile">
					<Image src={clownologie} alt="Affiche Clownologie" />
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<p class="eyebrow">En scène</p>
			<h2>En images</h2>
			<div class="en-images">
				{
					enImages.map((photo) => (
						<div class="photo-tile">
							<Image
								src={photo.src}
								alt={photo.alt}
								widths={[400, 800]}
								sizes="(max-width: 760px) 100vw, 33vw"
							/>
						</div>
					))
				}
			</div>
			<a class="btn" href="/galerie">Toute la galerie</a>
		</div>
	</section>

	<section class="section section-alt">
		<div class="wrap peniche-grid">
			<div>
				<p class="eyebrow">Le lieu</p>
				<h2>{site.peniche.nom}</h2>
				<p>
					Amarrée sur le Canal de l'Ourcq, au bord du quai de l'Oise dans le 19ᵉ arrondissement
					de Paris, la Péniche Grande Fantaisie accueille chaque mercredi la programmation du
					collectif : ateliers, spectacles, créations jeune public, cabarets et scènes ouvertes.
				</p>
				<a class="btn" href={site.peniche.mapsUrl} target="_blank" rel="noopener">
					{site.peniche.adresse}
				</a>
			</div>
			<div>
				<p class="eyebrow">Contact</p>
				<h2>Nous écrire</h2>
				<p>
					Pour proposer un numéro, rejoindre une scène ouverte ou toute question sur la
					programmation, contactez {site.contact.nom} :
				</p>
				<p>
					<a href={`mailto:${site.contact.email}`}>{site.contact.email}</a><br />
					{site.contact.telephone}
				</p>
			</div>
		</div>
	</section>
</Layout>

<style>
	.intro-grid {
		display: grid;
		grid-template-columns: 340px 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.portrait {
		aspect-ratio: 2 / 3;
		overflow: hidden;
		border-radius: 4px;
	}

	.portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.affiches {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.affiche-tile {
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border-radius: 4px;
	}

	.affiche-tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.en-images {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1rem;
		margin: 1.5rem 0 2rem;
	}

	.photo-tile {
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: 4px;
	}

	.photo-tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.peniche-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
	}

	@media (max-width: 760px) {
		.intro-grid,
		.peniche-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
