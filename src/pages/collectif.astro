---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import portrait from '../assets/posters/clown-usine-6-nov-2025-rouge.jpg';
import clownologie from '../assets/posters/clownologie.jpg';
import cabaretMigractions from '../assets/posters/cabaret-clown-usine-1.jpg';
import usineNoir from '../assets/posters/clown-usine-6-nov-2025-noir.jpg';
import usine19Mai from '../assets/posters/clown-usine-19-mai-2026.jpg';
import cabaret21Mai from '../assets/posters/cabaret-clown-21-mai-2026.jpg';
import usinePeniche from '../assets/posters/clown-usine-peniche.jpg';
import kBarreAvril from '../assets/posters/cabaret-k-barre-avril.jpg';
import kBarreSeptembre from '../assets/posters/cabaret-k-barre-septembre.jpg';
import francoisMontage from '../assets/equipe/francois-montage.jpg';
import francoisHublot from '../assets/equipe/francois-hublot.jpg';
import alainHublot from '../assets/equipe/alain-hublot.jpg';
import antimagiaAffiche from '../assets/equipe/antimagia-affiche.jpg';
import antimagia from '../assets/equipe/antimagia.jpg';
import laTierraLune from '../assets/equipe/la-tierra-lune.jpg';
import laTierraTerre from '../assets/equipe/la-tierra-terre.jpg';
import laTierraDrapeau from '../assets/equipe/la-tierra-drapeau.jpg';
import noirBlanc from '../assets/equipe/spectacle-noir-blanc.jpg';
import salut from '../assets/photos/salut-troupe.jpg';
import duo from '../assets/photos/duo-paravent.jpg';
import trench from '../assets/photos/clown-trench.jpg';
import drape1 from '../assets/photos/clown-drape-1.jpg';
import drape2 from '../assets/photos/clown-drape-2.jpg';
import marie from '../assets/photos/marie-cafe-de-paris.jpg';

// Affiches envoyées par Pancho (2026-10-03), à peu près dans l'ordre chronologique.
const affiches = [
	{ src: cabaretMigractions, alt: 'Affiche Cabaret Clown « Clown à l’usine ! », festival MigrActions, 2 juillet 2025' },
	{ src: usineNoir, alt: 'Affiche Clown à l’usine, cabaret clown du 6 novembre 2025 à la Péniche Grande Fantaisie' },
	{ src: kBarreAvril, alt: 'Affiche Cabaret K barré et autres rébus hilarants, au Café de Paris, en avril' },
	{ src: usine19Mai, alt: 'Affiche Clown à l’usine, cabaret clown du 19 mai 2026 à la Péniche Grande Fantaisie' },
	{ src: cabaret21Mai, alt: 'Affiche Cabaret Clown à l’usine du 21 mai 2026 à la Péniche Grande Fantaisie' },
	{ src: clownologie, alt: 'Affiche Clownologie, spectacle cabaret du collectif Clown à l’usine, juin 2026' },
	{ src: kBarreSeptembre, alt: 'Affiche Cabaret K barré et autres rébus hilarants, au Café de Paris, 26 septembre' },
	{ src: usinePeniche, alt: 'Affiche Clown à l’usine, cabaret clown à la Péniche Grande Fantaisie, deux clowns au nez rouge' },
];

// Parcours de François au Mexique (photos envoyées par Pancho, 2026-10-04).
const mexique = [
	{ src: antimagiaAffiche, alt: 'Affiche du spectacle Antimagia y otras cosas, Teatro Coyoacán, Mexico, 2009' },
	{ src: antimagia, alt: 'Antimagia y otras cosas : deux clowns ébahis devant une flamme, rideau rouge' },
	{ src: laTierraLune, alt: 'La Tierra es azul como una naranja : la scène sous une grande lune' },
	{ src: laTierraTerre, alt: 'La Tierra es azul como una naranja : les comédiens sous une planète bleue' },
	{ src: laTierraDrapeau, alt: 'La Tierra es azul como una naranja : trois comédiennes et un drapeau rouge' },
	{ src: noirBlanc, alt: 'Spectacle de la compagnie Cocodrilo Produxión, photo en noir et blanc' },
];

const enImages = [
	{ src: salut, alt: 'Salut final de la troupe de clowns sur la scène de la Péniche Grande Fantaisie' },
	{ src: duo, alt: 'Duo de clowns au nez rouge devant un paravent fleuri, sur la péniche' },
	{ src: trench, alt: 'Clown en trench-coat et chaussettes rayées, un carnet à la main' },
	{ src: drape1, alt: 'Clown drapé dans un tissu gris face au public, spectacle Clownologie' },
	{ src: drape2, alt: 'Clown drapé, la main sur le cœur, devant les enfants du public' },
	{ src: marie, alt: 'Marie en clown, veste rouge et nœud vert, sur la scène du Café de Paris' },
];
---

<Layout
	title="Le Collectif"
	fullTitle="Le collectif Clown, dos, tres · Artistes clowns à Paris"
	description="Collectif d'artistes clowns de François Durègne (Pancho Durango) et Alain Carbonnel : histoire, équipe et affiches. Péniche Grande Fantaisie, Paris 19e."
>
	<section class="section intro">
		<div class="wrap intro-grid">
			<div class="portrait">
				<Image src={portrait} alt="Affiche Clown à l’usine : tapette à mouches et clé à molette croisées sur un nez rouge, cabaret clown à la Péniche Grande Fantaisie" />
			</div>
			<div>
				<h1>Le collectif Clown, dos, tres</h1>
				<p>
					En mars 2024 naît l’atelier hebdomadaire de l’usine Chapal à Montreuil, un atelier de
					recherche et de création autour du clown contemporain, sous l’impulsion de <strong
						>François Durègne</strong
					>, clown, metteur en scène et pédagogue.
				</p>
				<p>
					En juin 2024 se crée un premier spectacle, sous la forme d’un cabaret fait de numéros
					de clown, du nom de «&nbsp;Clown à l’usine&nbsp;».
				</p>
				<p>
					Après deux années de recherche, de rencontres et de cabarets, François Durègne est
					invité en résidence sur la péniche Grande Fantaisie en septembre 2026. Le collectif
					prend le nom de «&nbsp;Clown, dos, tres&nbsp;» et s’y installe avec le projet d’ouvrir un
					nouvel espace pour le clown dans le 19ᵉ arrondissement.
				</p>
				<p>
					<strong>Le collectif Clown, dos, tres</strong> réunit des artistes clowns venus de
					divers horizons, dans un esprit tourné vers la recherche et la création collective. Il
					met particulièrement l’accent sur la dramaturgie du numéro et l’écriture du clown
					contemporain.
				</p>
			</div>
		</div>
	</section>

	<section class="section section-alt equipe">
		<div class="wrap">
			<p class="eyebrow">L’équipe</p>
			<h2>Les membres du collectif</h2>

			<article class="membre">
				<div class="hublot">
					<Image src={francoisHublot} alt="Portrait de François Durègne, dit Pancho Durango, sur scène" widths={[240, 480]} sizes="240px" />
				</div>
				<div class="bio">
					<h3>François Durègne</h3>
					<p class="role">Clown, metteur en scène</p>
					<p>
						Acteur, clown puis metteur en scène et formateur, il dirige pendant plus de 10 ans la
						compagnie <strong>Cocodrilo Produxión</strong> au Mexique, où il réside entre 2005 et
						2021, travaillant avec les principales institutions culturelles du pays.
					</p>
					<p>
						En tant que clown, <strong>Pancho Durango</strong> a joué sur les grandes scènes et dans
						les festivals les plus reconnus du Mexique. Son spectacle <em>Antimagia y otras cosas</em> compte plus de
						350 représentations à son actif.
					</p>
					<p>
						Il a enseigné le jeu du clown et de l’acteur à l’université et dans des écoles
						professionnelles. En tant que metteur en scène, il a dirigé une vingtaine de créations.
						Il a écrit puis monté <em>Cuántos Cuentos Cuentas</em>, ensuite repris par plusieurs
						compagnies au Mexique, au Chili, à Cuba et en Colombie.
					</p>
				</div>
			</article>
			<Image
				src={francoisMontage}
				alt="Montage de photos : François Durègne en clown, et ses spectacles Cuántos Cuentos Cuentas et La Tierra es azul como una naranja"
				class="montage"
				widths={[700, 1400]}
				sizes="(max-width: 1100px) 100vw, 1100px"
			/>
			<div class="mexique">
				{
					mexique.map((photo) => (
						<Image src={photo.src} alt={photo.alt} widths={[300, 600]} sizes="(max-width: 760px) 50vw, 360px" />
					))
				}
			</div>

			<article class="membre">
				<div class="hublot">
					<Image src={alainHublot} alt="Portrait d’Alain Carbonnel, bras croisés" widths={[240, 480]} sizes="240px" />
				</div>
				<div class="bio">
					<h3>Alain Carbonnel</h3>
					<p class="role">Comédien, clown, musicien</p>
					<p>
						Formé tout d’abord comme comédien au Théâtre national de Strasbourg, il y suit des cours
						de jeu masqué et de clown avec Marc Proulx. Depuis, en parallèle de sa carrière de
						comédien, il suit des stages de clown auprès d’Alain Gautré et de François Durègne.
					</p>
					<p>
						Également musicien et chanteur, il participe à de nombreux cabarets avec le collectif
						Les Cabarettistes. Il joue dans le spectacle de clown <em>Mea Culpa</em>, écrit et mis en
						scène par François Durègne, puis intègre l’atelier de recherche et de création Clown à
						l’usine et participe en tant que metteur en scène à l’élaboration de <em>K barré et autres rébus hilarants</em>. En 2026, il intègre le collectif Clown, dos,
						tres.
					</p>
				</div>
			</article>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<p class="eyebrow">En affiches</p>
			<h2>Cabarets &amp; spectacles</h2>
			<div class="affiches">
				{
					affiches.map((affiche) => (
						<Image src={affiche.src} alt={affiche.alt} widths={[300, 600]} sizes="(max-width: 760px) 50vw, 280px" />
					))
				}
			</div>
		</div>
	</section>

	<section class="section section-alt">
		<div class="wrap">
			<p class="eyebrow">En scène</p>
			<h2>En images</h2>
			<div class="en-images">
				{
					enImages.map((photo) => (
						<div class="photo-tile">
							<Image
								src={photo.src}
								alt={photo.alt}
								widths={[400, 800]}
								sizes="(max-width: 760px) 100vw, 33vw"
							/>
						</div>
					))
				}
			</div>
			<a class="btn" href="/galerie">Toute la galerie</a>
		</div>
	</section>

	<section class="section">
		<div class="wrap peniche-grid">
			<div>
				<p class="eyebrow">Le lieu</p>
				<h2>{site.peniche.nom}</h2>
				<p>
					Amarrée sur le Canal de l'Ourcq, au bord du quai de l'Oise dans le 19ᵉ arrondissement
					de Paris, la Péniche Grande Fantaisie accueille chaque mercredi la programmation du
					collectif : ateliers, spectacles, créations jeune public, cabarets et scènes ouvertes.
				</p>
				<a class="btn" href={site.peniche.mapsUrl} target="_blank" rel="noopener">
					{site.peniche.adresse}
				</a>
			</div>
			<div>
				<p class="eyebrow">Contact</p>
				<h2>Nous écrire</h2>
				<p>
					Pour participer aux Mercredis du Clown, proposer un numéro ou déposer un projet :<br />
					<a href={`mailto:${site.contact.programmation}`}>{site.contact.programmation}</a>
				</p>
				<p>
					Pour toute autre question :<br />
					<a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
				</p>
			</div>
		</div>
	</section>
</Layout>

<style>
	.intro-grid {
		display: grid;
		grid-template-columns: 340px 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.portrait {
		aspect-ratio: 2 / 3;
		overflow: hidden;
		border-radius: 4px;
	}

	.portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.membre {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: 2.5rem;
		align-items: start;
		margin-top: 2.5rem;
	}

	.membre h3 {
		margin: 0.2em 0 0;
		font-size: 1.7rem;
	}

	/* Portrait dans un hublot de bateau : anneau de laiton riveté. */
	.hublot {
		position: relative;
		aspect-ratio: 1;
		border-radius: 50%;
		padding: 16px;
		background: conic-gradient(from 210deg, #8a6424, #e2bd6a, #9c7330, #f0d48d, #8a6424, #d3a94f, #8a6424);
		box-shadow: 0 8px 20px rgba(36, 21, 18, 0.35);
	}

	.hublot::before {
		/* rivets */
		content: '';
		position: absolute;
		inset: 4px;
		border-radius: 50%;
		background:
			radial-gradient(circle at 50% 2.5%, #5c4214 0 3px, transparent 4px),
			radial-gradient(circle at 50% 97.5%, #5c4214 0 3px, transparent 4px),
			radial-gradient(circle at 2.5% 50%, #5c4214 0 3px, transparent 4px),
			radial-gradient(circle at 97.5% 50%, #5c4214 0 3px, transparent 4px),
			radial-gradient(circle at 16.5% 16.5%, #5c4214 0 3px, transparent 4px),
			radial-gradient(circle at 83.5% 16.5%, #5c4214 0 3px, transparent 4px),
			radial-gradient(circle at 16.5% 83.5%, #5c4214 0 3px, transparent 4px),
			radial-gradient(circle at 83.5% 83.5%, #5c4214 0 3px, transparent 4px);
		pointer-events: none;
	}

	.hublot :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
		box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.4);
		border: 3px solid #5c4214;
	}

	.role {
		font-style: italic;
		margin-top: -0.4em;
	}

	.montage {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
		margin: 1.5rem 0;
	}

	.bio {
		max-width: 46em;
	}

	.mexique {
		columns: 3 220px;
		column-gap: 1rem;
		margin-top: 2rem;
	}

	.mexique :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 1rem;
		break-inside: avoid;
		border-radius: 4px;
	}

	/* Affiches de formats différents : colonnes, chaque affiche garde son format (ni recadrage ni bandes). */
	.affiches {
		columns: 4 220px;
		column-gap: 1.25rem;
		margin-top: 1.5rem;
	}

	.affiches :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 1.25rem;
		break-inside: avoid;
		border-radius: 4px;
	}

	.en-images {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1rem;
		margin: 1.5rem 0 2rem;
	}

	.photo-tile {
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: 4px;
	}

	.photo-tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.peniche-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
	}

	@media (max-width: 760px) {
		.membre {
			grid-template-columns: 1fr;
		}

		.hublot {
			width: 200px;
		}

		.intro-grid,
		.peniche-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
