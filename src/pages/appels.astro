---
import Layout from '../layouts/Layout.astro';
import { appels, misAJour, zone } from '../data/appels';

const dateFr = (iso: string) =>
	new Date(`${iso}T12:00:00`).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const zones = [
	{ id: 'tous', label: 'Partout' },
	{ id: 'paris', label: 'Paris & Île-de-France' },
	{ id: 'france', label: 'Reste de la France' },
	{ id: 'europe', label: 'Europe' },
];
const statuts = [
	{ id: 'tous', label: 'Tous' },
	{ id: 'ouvert', label: 'Ouverts' },
	{ id: 'récurrent/à venir', label: 'Récurrents / à venir' },
];
const nbOuverts = appels.filter((a) => a.statut === 'ouvert').length;

// Jours restants avant une date limite (calculés à la construction ; le script de la page
// les recalcule dans le navigateur pour rester justes entre deux mises à jour).
const joursRestants = (iso: string) =>
	Math.round((Date.parse(`${iso}T12:00:00`) - Date.parse(`${misAJour}T12:00:00`)) / 86_400_000);
const URGENT = 14; // jours : compte à rebours en rouge
const PROCHE = 60; // jours : affiché dans l'encadré « Dates limites proches »
const ancre = (a: (typeof appels)[number]) =>
	'appel-' + a.nom.toLowerCase().normalize('NFD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const proches = appels.filter(
	(a) => a.date_limite && joursRestants(a.date_limite) >= 0 && joursRestants(a.date_limite) <= PROCHE,
);
---

<Layout
	title="Appels à numéros"
	fullTitle="Appels à candidature clown · Scènes ouvertes et festivals"
	description="Appels à candidature pour numéros de clown en France et en Europe : scènes ouvertes, cabarets, tremplins et festivals. Dates limites, critères, rémunération, contacts."
>
	<section class="section">
		<div class="wrap">
			<p class="eyebrow">Pour les artistes</p>
			<h1>Appels à numéros de clown</h1>
			<p>
				Scènes ouvertes, cabarets, tremplins et festivals qui cherchent des numéros de clown, en
				France et dans les grandes villes d’Europe. {nbOuverts} appel{nbOuverts > 1 ? 's' : ''} ouvert{
					nbOuverts > 1 ? 's' : ''
				} en ce moment ; les autres reviennent chaque saison.
			</p>
			<p class="maj">
				Vérifié le {dateFr(misAJour)}. Les dates bougent : confirmez toujours sur le lien de
				l’appel avant d’envoyer.
				<a href="/appels.csv" download="appels-clown.csv">Télécharger le tableau (Excel / CSV)</a>
			</p>

			<div class="filtres" role="group" aria-label="Filtrer les appels">
				<div>
					{
						zones.map((z, i) => (
							<button type="button" data-filtre="zone" data-valeur={z.id} aria-pressed={i === 0 ? 'true' : 'false'}>
								{z.label}
							</button>
						))
					}
				</div>
				<div>
					{
						statuts.map((s, i) => (
							<button type="button" data-filtre="statut" data-valeur={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>
								{s.label}
							</button>
						))
					}
				</div>
			</div>

			{
				proches.length > 0 && (
					<aside class="proches" aria-labelledby="titre-proches">
						<h2 id="titre-proches">Dates limites proches</h2>
						<ol>
							{proches.map((a) => (
								<li data-limite={a.date_limite} data-zone={zone(a)} data-statut={a.statut}>
									<span class={`compte ${joursRestants(a.date_limite!) <= URGENT ? 'urgent' : ''}`}>
										J-{joursRestants(a.date_limite!)}
									</span>
									<span class="quand">{dateFr(a.date_limite!)}</span>
									<a href={`#${ancre(a)}`}>{a.nom}</a>
									<span class="ville">{a.ville}{a.pays !== 'France' && `, ${a.pays}`}</span>
								</li>
							))}
						</ol>
					</aside>
				)
			}

			<div class="appels">
				{
					appels.map((a) => (
						<article class="appel" id={ancre(a)} data-zone={zone(a)} data-statut={a.statut}>
							<p class="echeance">
								{a.statut === 'ouvert' ? (
									<span class="badge ouvert">Ouvert</span>
								) : (
									<span class="badge">Récurrent</span>
								)}
								{a.date_limite && a.date_limite >= misAJour ? (
									<span>
										Date limite : <strong>{dateFr(a.date_limite)}</strong>{' '}
										<span
											class={`compte ${joursRestants(a.date_limite) <= URGENT ? 'urgent' : ''}`}
											data-limite={a.date_limite}
										>
											J-{joursRestants(a.date_limite)}
										</span>
									</span>
								) : a.date_limite ? (
									<span>Dernier appel clos le {dateFr(a.date_limite)}</span>
								) : (
									<span>Date limite à confirmer</span>
								)}
							</p>
							<h2>
								{a.nom}
								{a.edition && <span class="edition"> · {a.edition}</span>}
							</h2>
							<p class="ou">
								{a.type} · {a.ville}
								{a.pays !== 'France' && `, ${a.pays}`}
								{a.lieu && ` · ${a.lieu}`}
							</p>
							<dl>
								{a.dates_evenement && (
									<>
										<dt>Dates</dt>
										<dd>{a.dates_evenement}</dd>
									</>
								)}
								{a.recurrence && (
									<>
										<dt>Récurrence</dt>
										<dd>{a.recurrence}</dd>
									</>
								)}
								{a.duree_numero && (
									<>
										<dt>Numéro</dt>
										<dd>{a.duree_numero}</dd>
									</>
								)}
								{a.criteres && (
									<>
										<dt>Critères</dt>
										<dd>{a.criteres}</dd>
									</>
								)}
								{a.remuneration && (
									<>
										<dt>Rémunération</dt>
										<dd>{a.remuneration}</dd>
									</>
								)}
								{a.frais_inscription && (
									<>
										<dt>Inscription</dt>
										<dd>{a.frais_inscription}</dd>
									</>
								)}
								{a.contact && (
									<>
										<dt>Contact</dt>
										<dd>{a.contact}</dd>
									</>
								)}
								{a.notes && (
									<>
										<dt>À savoir</dt>
										<dd>{a.notes}</dd>
									</>
								)}
							</dl>
							<a class="lien" href={a.lien} target="_blank" rel="noopener">
								Voir l’appel ↗
							</a>
						</article>
					))
				}
			</div>
			<p class="vide" hidden>Aucun appel pour ces filtres.</p>
		</div>
	</section>
</Layout>

<script>
	// Compte à rebours recalculé au jour de la visite.
	const aujourdhui = new Date();
	aujourdhui.setHours(12, 0, 0, 0);
	document.querySelectorAll<HTMLElement>('[data-limite]').forEach((el) => {
		const jours = Math.round((Date.parse(`${el.dataset.limite}T12:00:00`) - aujourdhui.getTime()) / 86_400_000);
		const compte = el.matches('.compte') ? el : el.querySelector<HTMLElement>('.compte');
		if (jours < 0) {
			if (el.tagName === 'LI') el.dataset.passe = 'oui';
			else if (compte) compte.textContent = 'clos';
			return;
		}
		if (compte) {
			compte.textContent = jours === 0 ? 'dernier jour' : `J-${jours}`;
			compte.classList.toggle('urgent', jours <= 14);
		}
	});

	const filtres = { zone: 'tous', statut: 'tous' };
	const cartes = document.querySelectorAll<HTMLElement>('.appel');
	const lignesProches = document.querySelectorAll<HTMLElement>('.proches li');
	const encadre = document.querySelector<HTMLElement>('.proches');
	const vide = document.querySelector<HTMLElement>('.vide');

	const correspond = (el: HTMLElement) =>
		(filtres.zone === 'tous' || el.dataset.zone === filtres.zone) &&
		(filtres.statut === 'tous' || el.dataset.statut === filtres.statut);

	// L'encadré « Dates limites proches » suit les mêmes filtres que les fiches.
	function majEncadre() {
		let lignes = 0;
		lignesProches.forEach((li) => {
			const ok = li.dataset.passe !== 'oui' && correspond(li);
			li.hidden = !ok;
			if (ok) lignes++;
		});
		if (encadre) encadre.hidden = lignes === 0;
	}
	majEncadre();

	document.querySelectorAll<HTMLButtonElement>('[data-filtre]').forEach((bouton) => {
		bouton.addEventListener('click', () => {
			const cle = bouton.dataset.filtre as keyof typeof filtres;
			filtres[cle] = bouton.dataset.valeur ?? 'tous';
			document
				.querySelectorAll<HTMLButtonElement>(`[data-filtre="${cle}"]`)
				.forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)));
			let visibles = 0;
			cartes.forEach((carte) => {
				const ok = correspond(carte);
				carte.hidden = !ok;
				if (ok) visibles++;
			});
			if (vide) vide.hidden = visibles > 0;
			majEncadre();
		});
	});
</script>

<style>
	.maj {
		font-size: 0.9rem;
		opacity: 0.85;
	}

	.maj a {
		display: inline-block;
		margin-left: 0.3em;
		font-weight: 700;
	}

	.proches {
		background: var(--rouge);
		color: var(--creme-clair);
		border-radius: 4px;
		padding: 1.2rem 1.5rem;
		margin: 0 0 1.5rem;
	}

	.proches h2 {
		color: var(--or);
		font-size: 1.3rem;
		margin: 0 0 0.6rem;
	}

	.proches ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.45rem;
	}

	.proches li {
		display: grid;
		grid-template-columns: 5.5rem 9.5rem 1fr auto;
		gap: 0.8rem;
		align-items: baseline;
	}

	.proches li[hidden],
	.proches[hidden] {
		display: none;
	}

	.proches a {
		color: var(--creme-clair);
		font-weight: 700;
	}

	.proches .ville {
		font-style: italic;
		opacity: 0.85;
		font-size: 0.9rem;
	}

	.proches .quand {
		font-size: 0.9rem;
	}

	.compte {
		display: inline-block;
		font-family: 'Bebas Neue', sans-serif;
		letter-spacing: 0.05em;
		font-size: 0.95rem;
		padding: 0.05em 0.6em;
		border-radius: 999px;
		background: var(--or);
		color: var(--encre);
		text-align: center;
	}

	.compte.urgent {
		background: var(--rouge-vif);
		color: var(--creme-clair);
	}

	.proches .compte.urgent {
		background: var(--creme-clair);
		color: var(--rouge-vif);
	}

	.appel:target {
		outline: 3px solid var(--or);
		outline-offset: 2px;
	}

	@media (max-width: 760px) {
		.proches li {
			grid-template-columns: auto 1fr;
			gap: 0.2rem 0.7rem;
		}

		.proches li a,
		.proches li .ville {
			grid-column: 2;
		}
	}

	.filtres {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem 2rem;
		margin: 1.5rem 0;
	}

	.filtres div {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.filtres button {
		font: inherit;
		font-size: 0.85rem;
		padding: 0.35em 0.9em;
		border-radius: 999px;
		border: 1px solid var(--rouge);
		background: transparent;
		color: var(--rouge);
		cursor: pointer;
	}

	.filtres button[aria-pressed='true'] {
		background: var(--rouge);
		color: var(--creme-clair);
	}

	.appels {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1.25rem;
	}

	.appel {
		background: var(--creme-clair);
		border: 1px solid var(--ombre);
		border-left: 5px solid var(--or);
		border-radius: 4px;
		padding: 1.25rem 1.4rem;
		display: flex;
		flex-direction: column;
	}

	.appel[data-statut='ouvert'] {
		border-left-color: var(--rouge);
	}

	.appel[hidden] {
		display: none;
	}

	.echeance {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-size: 0.9rem;
	}

	.badge.ouvert {
		background: var(--rouge);
		color: var(--creme-clair);
	}

	h2 {
		font-size: 1.25rem;
		margin: 0.6em 0 0.2em;
	}

	.edition {
		font-size: 0.8em;
		opacity: 0.7;
	}

	.ou {
		margin: 0 0 0.6em;
		font-style: italic;
		font-size: 0.92rem;
	}

	dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.3rem 0.8rem;
		margin: 0 0 0.8rem;
		font-size: 0.9rem;
	}

	dt {
		font-weight: 700;
	}

	dd {
		margin: 0;
		overflow-wrap: anywhere;
	}

	.lien {
		margin-top: auto;
		font-weight: 700;
	}
</style>
