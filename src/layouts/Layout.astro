---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { collectif, siteWeb } from '../data/schema';

interface Props {
	title: string;
	/** Titre complet de l'onglet, sans le suffixe « · Clown, dos, tres » (ex. accueil). */
	fullTitle?: string;
	description?: string;
	image?: string;
	/** Données structurées schema.org propres à la page (ex. événements). */
	schema?: object[];
}

const {
	title,
	fullTitle,
	description = "Un rendez-vous clown hebdomadaire sur la Péniche Grande Fantaisie, à Paris — ateliers, spectacles, cabarets et scènes ouvertes, ouverts à toutes et tous.",
	image = '/og-image.jpg',
	schema = [],
} = Astro.props;

const pageTitle = fullTitle ?? `${title} · Clown, dos, tres`;
const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [collectif, siteWeb, ...schema],
});
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="google-site-verification" content="9vhOz75gMUqbeXltX0-xU13U7h_LS5QNpCi68Aq8x5Q" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
			rel="stylesheet"
		/>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Clown, dos, tres" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="fr_FR" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />

		<script type="application/ld+json" set:html={jsonLd} />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
