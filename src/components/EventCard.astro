---
import { Image } from 'astro:assets';
import type { Evenement } from '../data/evenements';
import { site } from '../data/site';

interface Props {
	evenement: Evenement;
}

const { evenement } = Astro.props;

const labels: Record<Evenement['type'], string> = {
	'scene-ouverte': 'Scène ouverte',
	clownologie: 'Clownologie',
	cabaret: 'Cabaret',
	spectacle: 'Spectacle',
	atelier: 'Atelier',
	autre: 'Rendez-vous',
};
---

<article class={`event-card ${evenement.type}`}>
	{
		evenement.image && (
			<Image
				src={evenement.image}
				alt={evenement.imageAlt ?? `Affiche : ${evenement.titre}`}
				class="visuel"
				widths={[400, 800]}
				sizes="(max-width: 760px) 100vw, 360px"
			/>
		)
	}
	<span class={`badge ${evenement.type === 'scene-ouverte' ? 'scene-ouverte' : ''}`}>
		{labels[evenement.type]}
	</span>
	<h3>{evenement.date}</h3>
	{evenement.reporte ? <p class="reporte">{evenement.reporte}</p> : evenement.heure && <p class="heure">{evenement.heure}</p>}
	<p class="titre">{evenement.titre}</p>
	{evenement.description && <p class="desc">{evenement.description}</p>}
	{evenement.compagnie && <p class="desc compagnie">Par la {evenement.compagnie}</p>}
	{
		evenement.type === 'scene-ouverte' && (
			<p class="desc credits">
				Un événement organisé avec le soutien de l’association {site.sceneOuverte.soutien} · Photo et vidéo :
				{site.sceneOuverte.photoVideo}
			</p>
		)
	}
	<p class="infos">
		{evenement.lieu}
		{evenement.prix && ` · ${evenement.prix}`}
	</p>
	{
		evenement.reservation && !evenement.reporte && (
			<div class="actions">
				<a
					class="btn"
					href={`mailto:${site.contact.email}?subject=${encodeURIComponent(`Réservation – ${evenement.titre} – ${evenement.date}`)}`}
				>
					Réserver
				</a>
				{evenement.type === 'scene-ouverte' && (
					<a
						class="proposer"
						href={`mailto:${site.contact.programmation}?subject=${encodeURIComponent(`Proposer un numéro – ${evenement.titre} – ${evenement.date}`)}`}
					>
						Proposer un numéro
					</a>
				)}
			</div>
		)
	}
	{
		evenement.lien && (
			<a class="btn" href={evenement.lien}>
				En savoir plus
			</a>
		)
	}
</article>

<style>
	.event-card {
		background: var(--creme-clair);
		border: 1px solid var(--ombre);
		border-left: 5px solid var(--or);
		border-radius: 4px;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.event-card.scene-ouverte {
		border-left-color: var(--rouge);
	}

	/* Ateliers : un jaune plus clair pour les distinguer des spectacles. */
	.event-card.atelier {
		background: #fdf4d3;
		border-left-color: #efd27a;
	}

	.event-card.atelier .badge {
		background: #f3dc8f;
	}

	.credits {
		font-size: 0.85rem;
		opacity: 0.8;
	}

	.compagnie {
		font-style: italic;
	}

	.visuel {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 3px;
		margin-bottom: 0.6rem;
	}

	h3 {
		font-size: 1.1rem;
		margin: 0.3em 0 0;
	}

	.reporte {
		margin: 0;
		font-weight: 700;
		color: var(--creme-clair);
		background: var(--rouge-vif);
		align-self: flex-start;
		padding: 0.15em 0.6em;
		border-radius: 3px;
	}

	.event-card:has(.reporte) h3,
	.event-card:has(.reporte) .visuel {
		opacity: 0.55;
	}

	.event-card:has(.reporte) h3 {
		text-decoration: line-through;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1rem;
		margin-top: 0.6rem;
	}

	.actions .btn {
		margin-top: 0;
	}

	.proposer {
		font-size: 0.9rem;
		font-weight: 700;
	}

	.heure {
		margin: 0;
		font-style: italic;
		color: var(--rouge-vif);
	}

	.titre {
		font-weight: 700;
		margin: 0.2em 0;
	}

	.desc {
		margin: 0;
		font-size: 0.95rem;
	}

	.infos {
		margin: 0.4em 0 0;
		font-size: 0.85rem;
		opacity: 0.75;
	}

	.btn {
		align-self: flex-start;
		margin-top: 0.6rem;
	}
</style>
